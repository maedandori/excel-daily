{
  "app": {
    "run_in_background": true,
    "start_with_windows": false,
    "show_status_on_start": false
  },
  "workbook": {
    "filename_pattern": "成形スケジュール*.xlsx",
    "selected_workbook": "",
    "choose_if_multiple": true
  },
  "sheets": {
    "day": "1班　昼勤",
    "night": "1班　夜勤 "
  },
  "hotkeys": {
    "day": "Ctrl+1",
    "night": "Ctrl+2",
    "refresh": "Ctrl+3",
    "tomorrow": "Ctrl+4"
  },
  "rows": {
    "day_start": 9,
    "night_start": 7,
    "step": 2,
    "max_entries": 12
  },
  "columns": {
    "mold_machine": "AN",
    "mold_time": "AO",
    "color_machine": "AR",
    "color_time": "AS",
    "color_before": "AU",
    "color_after": "AW"
  },
  "data_source": {
    "events_file": "",
    "api_url": "https://machine-control.maedandoris.workers.dev/api/excel-daily/events",
    "api_token": ""
  },
  "update_policy": {
    "preserve_past": true,
    "update_existing_time_only": true,
    "save_automatically": false
  },
  "auto_update": {
    "enabled": true,
    "check_interval_hours": 6,
    "repository": "maedandori/excel-daily"
  },
  "formatting": {
    "fast_excel_writes": true,
    "color_cells": true
  },
  "drying": {
    "enabled": true,
    "header": "乾燥原料必要",
    "max_entries": 5,
    "columns": {
      "machine": "AY",
      "production_start": "AZ",
      "drying_time": "BA"
    },
    "time_by_material": {
      "ABS": "",
      "PS-TH21": "",
      "PC": "",
      "ナイロン": "",
      "AS": ""
    }
  }
}
